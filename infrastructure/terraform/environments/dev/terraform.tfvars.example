aws_region         = "ap-south-1"
environment        = "dev"
vpc_cidr           = "10.40.0.0/16"
availability_zones = 2
nat_gateway_count  = 1
instance_type      = "t3.small"
ami_id             = "REPLACE_WITH_REGION_VALID_AMI_ID"
db_instance_class  = "db.t3.micro"
db_name            = "smart_insurance"
db_master_username = "smart_admin"
api_domain_name    = "api.example.invalid"
certificate_arn    = "REPLACE_WITH_VALIDATED_ACM_CERTIFICATE_ARN"
frontend_origin    = "https://portal.example.invalid"
application_image  = "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/smart-insurance-api:VERSION"
ecr_repository_arn = "arn:aws:ecr:ap-south-1:ACCOUNT_ID:repository/smart-insurance-api"
application_db_parameter_arn = "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/smart-insurance/dev/database"
jwt_parameter_arn = "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/smart-insurance/dev/jwt"
pii_parameter_arn = "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/smart-insurance/dev/pii"
kms_key_arn       = "arn:aws:kms:ap-south-1:ACCOUNT_ID:key/REPLACE_WITH_KEY_ID"
s3_bucket_name     = "replace-with-globally-unique-private-bucket"
alarm_email        = ""
