# Copy to .env locally and replace every placeholder. Never commit the real .env.
MYSQL_DATABASE=smart_insurance
MYSQL_USER=smart_app
DB_USERNAME=smart_app
DB_PASSWORD=REPLACE_WITH_STRONG_LOCAL_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_LOCAL_ROOT_PASSWORD
DB_URL=jdbc:mysql://localhost:3306/smart_insurance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MINUTES=60
PII_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./var/documents
SCANNER_MODE=development
SCANNER_HOST=localhost
SCANNER_PORT=3310
MAX_FILE_SIZE_MB=10
MAX_REQUEST_SIZE_MB=11
MAX_DOCUMENTS_PER_CLAIM=10
DEFAULT_SLA_DAYS=10
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
AWS_REGION=ap-south-1
S3_BUCKET=
EMAIL_MODE=log
EMAIL_WEBHOOK_URL=
EMAIL_API_TOKEN=
